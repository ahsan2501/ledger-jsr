# ---------- Supabase (Project Settings → API) ----------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The anon / publishable key. Safe in the browser: all data is protected by owner-only RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key. SERVER ONLY — used by the reminder scheduler. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Web Push (generate with: npx web-push generate-vapid-keys) ----------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for push services, e.g. mailto:you@example.com
VAPID_SUBJECT=mailto:you@example.com

# ---------- Scheduler ----------
# Long random string (openssl rand -hex 32). The cron caller sends: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# ---------- Privacy ----------
# Comma-separated emails allowed to sign in (recommended: just yours).
ALLOWED_EMAILS=you@example.com
# Set to true only to create your owner account the first time, then set back to false
# (and disable sign-ups in Supabase → Authentication → Sign In / Providers).
ALLOW_SIGNUP=false
